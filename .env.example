# --- Database (Postgres + pgvector) ---
# Local dev: matches docker-compose.yml. Production: Neon's *pooled*
# connection string (hostname contains "-pooler"), injected via Secret
# Manager rather than committed anywhere.
#
# Use `?ssl=require`, not `?sslmode=require` — Neon's dashboard shows the
# latter (the libpq/psycopg convention) by default, but asyncpg (this
# project's driver) expects `ssl=`. Depending on asyncpg version,
# `sslmode=` either errors outright or is silently ignored (i.e. connects
# without TLS, which Neon then rejects) — either way, `ssl=require` is
# the form actually documented for asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_qualifier

# --- LLM + Embeddings (one key covers both — same provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- HubSpot ---
# Private App access token (HubSpot retired standalone API keys) —
# HubSpot > Settings > Integrations > Private Apps.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- App ---
RULES_PATH=config/rules.yaml
LOG_LEVEL=INFO
# Cloud Run injects PORT automatically; default kept for local dev.
PORT=8080
